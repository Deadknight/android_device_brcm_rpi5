import /vendor/etc/init/hw/init.${ro.hardware}.usb.rc

on init
    symlink /sdcard /storage/sdcard0

on fs
    mount_all /vendor/etc/fstab.${ro.hardware} --early

on late-fs
    mount_all /vendor/etc/fstab.${ro.hardware} --late

# ARDA_PI5_BT_SELFHEAL_V4_NAMED_SERVICE
#
# V3 proved that the boot trigger itself fires, but its exec_background worker
# was not observed. V4 uses a named oneshot init service plus a separate
# vendor helper so service start/exit is visible in init logs and can be
# tested before reboot.
service arda_bt_selfheal_v4 /system/bin/sh /vendor/bin/arda-bt-selfheal-v4.sh
    class late_start
    user root
    group root
    disabled
    oneshot
    seclabel u:r:vendor_init:s0

on property:sys.boot_completed=1
    write /dev/kmsg "ARDA_PI5_BT_SELFHEAL_V4_TRIGGER"
    start arda_bt_selfheal_v4
